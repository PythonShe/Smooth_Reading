{
  "name": "@smooth-reading/core",
  "version": "0.1.0",
  "description": "Zero-dependency guided fixation reading: emphasise the first part of every word so the eye gets an artificial fixation point. Unicode-aware, streaming, ESM + CJS.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "reading",
    "readability",
    "fixation",
    "saccade",
    "typography",
    "accessibility",
    "text",
    "html",
    "intl-segmenter",
    "unicode",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PythonShe/Smooth_Reading.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/PythonShe/Smooth_Reading/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/PythonShe/Smooth_Reading/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "happy-dom": "^20.14.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
