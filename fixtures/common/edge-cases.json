[
  {
    "name": "empty string",
    "input": "",
    "options": {},
    "html": ""
  },
  {
    "name": "whitespace only",
    "input": "  \n\t ",
    "options": {},
    "html": "  \n\t "
  },
  {
    "name": "single-letter words at strength 2 get no fixation",
    "input": "a e i o u",
    "options": {
      "fixation": 2
    },
    "html": "a e i o u"
  },
  {
    "name": "single-letter words at strength 3 are fully emphasised",
    "input": "a e i o u",
    "options": {
      "fixation": 3
    },
    "html": "<b>a</b> <b>e</b> <b>i</b> <b>o</b> <b>u</b>"
  },
  {
    "name": "leading and trailing punctuation stays outside the fixation",
    "input": "...Hello, world!!!",
    "options": {
      "fixation": 3
    },
    "html": "...<b>Hel</b>lo, <b>wor</b>ld!!!"
  },
  {
    "name": "straight apostrophe joins a word",
    "input": "don't stop",
    "options": {
      "fixation": 3
    },
    "html": "<b>don</b>'t <b>st</b>op"
  },
  {
    "name": "typographic apostrophe joins a word",
    "input": "it’s fine",
    "options": {
      "fixation": 3
    },
    "html": "<b>it</b>’s <b>fi</b>ne"
  },
  {
    "name": "hyphens split words",
    "input": "well-known text-vide",
    "options": {
      "fixation": 3
    },
    "html": "<b>we</b>ll-<b>kno</b>wn <b>te</b>xt-<b>vi</b>de"
  },
  {
    "name": "combining marks count as one grapheme (decomposed naive)",
    "input": "naïve reading",
    "options": {
      "fixation": 3
    },
    "html": "<b>naï</b>ve <b>read</b>ing"
  },
  {
    "name": "emoji between words is a separator",
    "input": "hello 👋 world",
    "options": {
      "fixation": 3
    },
    "html": "<b>hel</b>lo 👋 <b>wor</b>ld"
  },
  {
    "name": "Cyrillic",
    "input": "Привет мир",
    "options": {
      "fixation": 3
    },
    "html": "<b>При</b>вет <b>ми</b>р"
  },
  {
    "name": "Greek",
    "input": "Καλημέρα κόσμε",
    "options": {
      "fixation": 3
    },
    "html": "<b>Καλη</b>μέρα <b>κόσ</b>με"
  },
  {
    "name": "Arabic (RTL): the bold prefix is the logical start of the word",
    "input": "مرحبا بالعالم",
    "options": {
      "fixation": 3
    },
    "html": "<b>مرح</b>با <b>بالع</b>الم"
  },
  {
    "name": "ampersand and angle brackets are escaped when tags are not ignored",
    "input": "Tom & Jerry <3 > 2",
    "options": {
      "fixation": 3,
      "ignoreHtmlTags": false
    },
    "html": "<b>To</b>m &amp; <b>Jer</b>ry &lt;3 &gt; 2"
  },
  {
    "name": "double quotes are escaped",
    "input": "He said \"hi\" & left",
    "options": {
      "fixation": 3,
      "ignoreHtmlTags": false
    },
    "html": "<b>H</b>e <b>sa</b>id &quot;<b>h</b>i&quot; &amp; <b>le</b>ft"
  },
  {
    "name": "existing tags pass through verbatim with ignoreHtmlTags",
    "input": "<p>Smooth <em>reading</em> works.</p>",
    "options": {
      "fixation": 3,
      "ignoreHtmlTags": true
    },
    "html": "<p><b>Smo</b>oth <em><b>read</b>ing</em> <b>wor</b>ks.</p>"
  },
  {
    "name": "text inside default skipTags is untouched",
    "input": "Try <code>toHtml(x)</code> now.",
    "options": {
      "fixation": 3
    },
    "html": "<b>Tr</b>y <code>toHtml(x)</code> <b>no</b>w."
  },
  {
    "name": "already emphasised markup is not wrapped a second time",
    "input": "<b>Smooth</b> reading",
    "options": {
      "fixation": 3
    },
    "html": "<b>Smooth</b> <b>read</b>ing"
  },
  {
    "name": "markup is escaped as plain text when ignoreHtmlTags is false",
    "input": "<p>Hi</p>",
    "options": {
      "fixation": 3,
      "ignoreHtmlTags": false
    },
    "html": "&lt;<b>p</b>&gt;<b>H</b>i&lt;/<b>p</b>&gt;"
  },
  {
    "name": "existing character reference passes through verbatim (ignoreHtmlTags)",
    "input": "Tom &amp; Jerry",
    "options": {
      "fixation": 3
    },
    "html": "<b>To</b>m &amp; <b>Jer</b>ry"
  },
  {
    "name": "character reference is a word boundary",
    "input": "don&#x27;t stop",
    "options": {
      "fixation": 3
    },
    "html": "<b>do</b>n&#x27;<b>t</b> <b>st</b>op"
  },
  {
    "name": "words split by a character reference each consume a saccade index",
    "input": "don&#x27;t stop now",
    "options": {
      "fixation": 3,
      "saccade": 2
    },
    "html": "<b>do</b>n&#x27;t <b>st</b>op now"
  },
  {
    "name": "bare ampersand is escaped even when tags are ignored",
    "input": "Tom & Jerry",
    "options": {
      "fixation": 3
    },
    "html": "<b>To</b>m &amp; <b>Jer</b>ry"
  },
  {
    "name": "ampersand without a semicolon is not a reference",
    "input": "AT&T works",
    "options": {
      "fixation": 3
    },
    "html": "<b>A</b>T&amp;<b>T</b> <b>wor</b>ks"
  },
  {
    "name": "decimal reference between words",
    "input": "&#169; 2024 Smooth",
    "options": {
      "fixation": 3
    },
    "html": "&#169; 2024 <b>Smo</b>oth"
  },
  {
    "name": "character reference is escaped as text when tags are not ignored",
    "input": "Tom &amp; Jerry",
    "options": {
      "fixation": 3,
      "ignoreHtmlTags": false
    },
    "html": "<b>To</b>m &amp;<b>am</b>p; <b>Jer</b>ry"
  },
  {
    "name": "angle bracket before a digit or space is text even when tags are ignored",
    "input": "5 < 6 and a<3",
    "options": {
      "fixation": 3
    },
    "html": "5 &lt; 6 <b>an</b>d <b>a</b>&lt;3"
  },
  {
    "name": "lone closing angle bracket is text",
    "input": "x > y",
    "options": {
      "fixation": 3
    },
    "html": "<b>x</b> &gt; <b>y</b>"
  },
  {
    "name": "declaration, processing instruction and closing tag pass through",
    "input": "<?xml version=\"1.0\"?><!DOCTYPE html><p>Hi</p>",
    "options": {
      "fixation": 3
    },
    "html": "<?xml version=\"1.0\"?><!DOCTYPE html><p><b>H</b>i</p>"
  },
  {
    "name": "comment passes through with its text untouched",
    "input": "<!-- not reading --> reading",
    "options": {
      "fixation": 3
    },
    "html": "<!-- not reading --> <b>read</b>ing"
  },
  {
    "name": "only decimal digits count as numbers: a letter-number is a word, non-ASCII digits are not",
    "input": "Ⅻ ٤٢ ３",
    "options": {
      "fixation": 3
    },
    "html": "<b>Ⅻ</b> ٤٢ ３"
  }
]
